# The same CantBlockBy with its IsPresent$ Artifact.DefenderCtrl met: the
# defending player controls Ornithopter, so a Grizzly Bears block is refused
# and, with none, the Beebles deal 2.
startturn human
advance 5
queue attackers 1
declareattackers
advance
queue blocks 2=1
expecterror 509.1b declareblockers
queue blocks none
declareblockers
advance
advance
combatdamage
