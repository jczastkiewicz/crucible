{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-commit-gates.sh",
            "timeout": 600,
            "statusMessage": "Running CI gates before commit"
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-upstream.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-on-edit.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-gates.sh",
            "timeout": 120,
            "statusMessage": "Fast gates (report only)"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(./scripts/gates.sh *)",
      "Bash(crucible/scripts/gates.sh *)",
      "Bash(go build *)",
      "Bash(go env *)",
      "Bash(go env)",
      "Bash(go run ./tools/apiscan -check*)",
      "Bash(go run ./tools/covergate *)",
      "Bash(go run ./tools/docgate *)",
      "Bash(go run ./tools/enginelint *)",
      "Bash(go run ./tools/javacycles *)",
      "Bash(go run ./tools/vocabscan *)",
      "Bash(go test *)",
      "Bash(go tool cover *)",
      "Bash(go version)",
      "Bash(go vet *)",
      "Bash(gofmt -l *)",
      "Bash(golangci-lint run *)",
      "Bash(golangci-lint run)",
      "Bash(npx markdownlint-cli2 *)",
      "Bash(prettier --check *)"
    ]
  }
}
